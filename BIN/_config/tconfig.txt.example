# --- КЛЮЧИ И МОДЕЛИ ---
MODEL_GEMINI=gemini-3-flash-preview
API_KEY=YOUR_GEMINI_API_KEY_HERE
MODEL_GPT=gpt-3.5-turbo
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
MODEL_WHISPER=large-v3

# --- ОБЛАЧНЫЕ СЕРВИСЫ ТРАНСКРИПЦИИ ---
# По умолчанию: 'local' (faster-whisper на CPU)
# Варианты: local, openai, google, azure
TRANSCRIBE_PROVIDER=local
# OpenAI Whisper API ключ (если используется openai)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Google Cloud Speech API ключ (если используется google)
GOOGLE_CLOUD_KEY_FILE=
# Azure Speech API ключ (если используется azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- ПУТИ КОРНЕВЫЕ ---
BASE_DIR=/Users/kivaonmac/Documents/AI_Lab

# --- ВХОД И ТЕХНИЧЕСКАЯ ЗОНА (02_TXT) ---
INBOX_DIR=${BASE_DIR}/01_INBOX
# Сюда экстракторы кладут сырой текст (OCR, транскрипты)
TXT_RAW=${BASE_DIR}/02_TXT/raw
# Здесь лежит облагороженный MD-текст (основной вход для TR)
MD_DIR=${BASE_DIR}/02_TXT/MD
# Совместимость со старым кодом
TXT_DIR=${BASE_DIR}/02_TXT/MD
# АУДИО ЗОНА
AUDIO_DIR=${BASE_DIR}/06_AUDIO
TTS_DIR=${BASE_DIR}/06_AUDIO/IN
ETHALON_DIR=${BASE_DIR}/06_AUDIO/VOICE
DEFAULT_VOICE=ru-RU-SvetlanaNeural
#DEFAULT_VOICE=ru-RU-SvetlanaNeural  # Женский голос
DEFAULT_TTS_METHOD=edge                 # Метод обработки
DEFAULT_TTS_SPEED=normal               # Скорость произношения
DEFAULT_LANGUAGE=ru                     # Язык по умолчанию
AUDIO_QUALITY=high                      # Качество (low/medium/high)
AUDIO_BITRATE=192k                      # Битрейт
DEFAULT_AUDIO_FORMAT=mp3                 # Формат

# --- OCR НАСТРОЙКИ ---
OCR_DIR=${BASE_DIR}/01_INBOX
DEFAULT_OCR_NAME=Agreement

# --- ЦЕХ ДОКУМЕНТОВ (03_DOC) ---
# Облагороженные MD-оригиналы в DOCX (для сверки)
DOC_ORIGINALS=${BASE_DIR}/03_DOC/ORIGINALS
# Готовый DOCX-перевод от TR
DOC_TRANSLATED=${BASE_DIR}/03_DOC/TRANSLATED
# Шлюз для паблишера (сюда копируем файлы вручную для печати)
DOC_TO_PUB=${BASE_DIR}/03_DOC/TO_PUB

# --- ФИНАЛ (04_PUB) ---
# Склад готовой верстки после паблишера
PUB_FINAL=${BASE_DIR}/04_PUB

# --- ТЕХНИЧЕСКИЙ АРХИВ (05_ARH) ---
ARH_VIDEO=${BASE_DIR}/05_ARH/VIDEO
ARH_AUDIO=${BASE_DIR}/05_ARH/AUDIO
ARH_TXT=${BASE_DIR}/05_ARH/TXT
ARH_PDF=${BASE_DIR}/05_ARH/PDF
ARH_IMG=${BASE_DIR}/05_ARH/IMG
ARH_DOC=${BASE_DIR}/05_ARH/DOC

# --- ОПЦИИ РАБОТЫ ---
# Режим печати паблишера по умолчанию (1 или 2 страницы на листе)
DEFAULT_PRINT_MODE=2
# Создавать ли причесанный оригинал параллельно с переводом
CREATE_CLEAN_ORIGINAL=True
# Спрашивать ли перед архивацией сырья
ASK_BEFORE_ARCHIVE=True
# Язык по умолчанию для перевода
TARGET_LANG=Russian

# --- ЛОГИ ---
LOG_FILE=BIN/_logs/tbox.log
# Уровень детализации: INFO, DEBUG, ERROR
LOG_LEVEL=INFO

# --- ПРОМПТЫ ---
PROMPTS_DIR=BIN/_config
